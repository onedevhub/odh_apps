<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Set partner context in Purchase Orders -->
    <record id="purchase_order_view_form_inherit_odh_customer_vendor" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.odh.customer.vendor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{'default_odh_vendor':True,'res_partner_search_mode': 'supplier', 'show_vat': True}</attribute>
            </field>
        </field>
    </record>
</odoo>
