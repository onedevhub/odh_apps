<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Set partner context in Sales Orders -->
    <record id="sale_order_view_form_inherit_odh_customer_vendor" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.odh.customer.vendor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{
                    'default_odh_customer': True,
                    'res_partner_search_mode': 'customer',
                    'show_address': 1,
                    'show_vat': True,
                }</attribute>
            </field>
        </field>
    </record>
</odoo>
